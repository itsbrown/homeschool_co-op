# Copy to `.env` and fill in. Used by `npm run dev` via `server/local-env.ts` (not committed).

# Postgres (dev + drizzle-kit push). Use a dedicated DB — never prod for tests.
# On Replit: wrong DATABASE_URL causes 403 REGISTRATION_REQUIRED after login (Supabase OK, no users row).
# Diagnose: node scripts/diagnose-login-user.mjs your@email.com
# DATABASE_URL=postgresql://user:password@localhost:5432/asa_dev
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/asa_test

# https://supabase.com/dashboard/project/_/settings/api

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Client (Vite); usually same values as SUPABASE_* above
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Google Drive (Week Planner Connect folder / Generate lesson).
# Local: node scripts/install-google-drive-service-account.mjs ~/Downloads/your-key.json
# Share each lesson folder with the key's client_email (Viewer). Unset → reindex 503.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=secrets/google-drive-service-account.json
# Replit/Railway: GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}

# Stripe test (see server/test-env-loader.ts)
TESTING_STRIPE_SECRET_KEY=sk_test_...
VITE_TESTING_STRIPE_PUBLIC_KEY=pk_test_...

# Daily missed-PI sweep (Layer 3). Production: unset = enabled (detect + alert).
# Dev: unset = off. Auto-fix always off unless true. Uses STRIPE_SECRET_KEY (not Replit connector).
# MISSED_PI_SWEEP_ENABLED=true
# MISSED_PI_SWEEP_AUTO_FIX=false
# MISSED_PI_SWEEP_LOOKBACK_DAYS=30
# STRIPE_SECRET_KEY=sk_test_...
